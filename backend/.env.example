# =============================================================================
# NARAD Environment Configuration Template
# Suitable for: LOCAL (Mac), CLOUD (Render/Fly/Railway), and SELF_HOSTED (Laptop)
# Copy this file to .env and configure local values.
# NEVER commit the actual .env file or real API keys to version control!
# =============================================================================

# 1. APPLICATION & RUNTIME TARGET
APP_NAME=NARAD
APP_ENV=production
# ENVIRONMENT: LOCAL | CLOUD | SELF_HOSTED
ENVIRONMENT=CLOUD
# NARAD_RUNTIME_MODE: local | cloud | hybrid
NARAD_RUNTIME_MODE=cloud
DEBUG=False
PORT=8000
HOST=0.0.0.0
# Public URL of THIS deployment (informational). Use the real host URL, e.g. the live
# Render service is https://narad-gqtp.onrender.com (see docs/CLOUD_DEPLOYMENT.md).
PUBLIC_BASE_URL=
LOG_LEVEL=INFO

# 2. SINGLE-USER SECURITY (MANDATORY IN CLOUD)
# Leave empty for unauthenticated local development. Set a strong token for cloud/mobile access.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# LOCAL: backend/.env is the canonical source. The Vite dev server (frontend/naradDevAuth.js)
# reads this same value and injects it server-side on /api requests; it never reaches the browser.
# Use a DIFFERENT value for the cloud deployment.
NARAD_API_KEY=narad_sec_replace_with_strong_random_token_here
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_SIZE_BYTES=15728640

# 3. DATABASE PERSISTENCE
# For LOCAL: sqlite:///./narad.db
# For CLOUD: postgresql://username:password@hostname:5432/narad
DATABASE_URL=sqlite:///./narad.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# 4. CORS ORIGINS (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://narad.local

# 5. CLOUD AI MODEL PROVIDERS (Required for cloud inference)
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NARAD_DEFAULT_PROVIDER=groq
NARAD_DEFAULT_MODEL=llama-3.3-70b-versatile

# 6. OPENAI-COMPATIBLE GATEWAY CONNECTOR (Optional / Future Mesh)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_NAME=OpenAI-Compatible Gateway

# 7. LOCAL NODE / FUTURE SELF-HOSTED LAPTOP SETTINGS
# Used when running on laptop or when laptop registers with cloud backend
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_TIMEOUT=30.0
OLLAMA_ENABLED=False

# 8. VOICE ENGINE (Chatterbox / Whisper)
# On cloud instances without GPU/Apple Silicon, local TTS/STT is marked standby/unavailable.
TTS_PROVIDER=chatterbox
TTS_LOCAL=False
TTS_DEVICE=auto
