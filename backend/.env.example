# NARAD Environment Configuration Template
# Copy this file to .env and configure local values.
# NEVER commit the actual .env file or real API keys to version control!

# Application Settings
APP_NAME=NARAD
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Database Configuration (SQLite for V1)
DATABASE_URL=sqlite:///./narad.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary AI Model Provider (Milestone 3)
GEMINI_API_KEY=
NARAD_DEFAULT_PROVIDER=gemini
NARAD_DEFAULT_MODEL=gemini-2.5-flash

# Future Expansion Connector Slots (Optional)
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
